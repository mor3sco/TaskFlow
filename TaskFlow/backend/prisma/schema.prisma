// prisma/schema.prisma
// TaskFlow — Evandro Moresco · Oggi Sec

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String?  @unique
  email        String   @unique
  passwordHash String?  // null para usuários OAuth
  googleId     String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks       Task[]
  ownedNotes  Note[]      @relation("OwnedNotes")
  sharedNotes NoteShare[] @relation("SharedNotes")

  @@map("users")
}

model Task {
  id          String    @id @default(cuid())
  text        String
  status      Status    @default(TODO)
  priority    Priority  @default(MEDIA)
  date        String    // formato 'YYYY-MM-DD'
  carriedFrom String?   // data de origem se foi transportada
  carriedTo   String?   // data para onde foi transportada
  completedAt DateTime? // preenchido quando status passa para DONE
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Note {
  id        String      @id @default(cuid())
  title     String
  content   String
  ownerId   String
  owner     User        @relation("OwnedNotes", fields: [ownerId], references: [id], onDelete: Cascade)
  shares    NoteShare[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("notes")
}

model NoteShare {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("SharedNotes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([noteId, userId])
  @@map("note_shares")
}

enum Status {
  TODO
  DOING
  DONE
}

enum Priority {
  ALTA
  MEDIA
  BAIXA
}
